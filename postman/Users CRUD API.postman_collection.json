{
  "info": {
    "_postman_id": "d58ac380-53e3-4e3f-bf5c-7737e3caa1b2",
    "name": "Users CRUD API",
    "description": "Sequential integration checks for the Users CRUD API. Run with the local API and MySQL database available.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" },
    { "key": "email", "value": "postman-user@example.com" }
  ],
  "item": [
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{email}}\",\n  \"age\": 30\n}"
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [{
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.collectionVariables.set('email', 'postman-user-' + Date.now() + '@example.com');"
          ]
        }
      }, {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Created with 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('Returns the created user', function () { pm.expect(body.data).to.include({ name: 'Postman User', email: pm.collectionVariables.get('email'), age: 30 }); });",
            "pm.collectionVariables.set('userId', body.data.id);"
          ]
        }
      }]
    },
    {
      "name": "Get all users",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Returns 200 and a users array', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });",
            "pm.test('Includes the created user', function () { pm.expect(pm.response.json().data.some((user) => user.id === Number(pm.collectionVariables.get('userId')))).to.be.true; });"
          ]
        }
      }]
    },
    {
      "name": "Get user by ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Returns the requested user', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('userId'))); });"
          ]
        }
      }]
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"age\": 31\n}"
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Returns the updated user', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.include({ name: 'Updated Postman User', age: 31 }); });"
          ]
        }
      }]
    },
    {
      "name": "Delete user",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Deletes with 204', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
          ]
        }
      }]
    },
    {
      "name": "Deleted user returns 404",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Returns 404 for deleted user', function () { pm.response.to.have.status(404); });"
          ]
        }
      }]
    },
    {
      "name": "Invalid create returns 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Missing email\"\n}" },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Rejects invalid create with 400', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.be.a('string'); });"
          ]
        }
      }]
    },
    {
      "name": "Invalid ID returns 400",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/not-an-id" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Rejects invalid ID with 400', function () { pm.response.to.have.status(400); });"
          ]
        }
      }]
    }
  ]
}
